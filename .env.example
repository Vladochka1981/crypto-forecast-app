# Пути
DATA_DIR=data
MODELS_DIR=data/models
CACHE_DIR=data/cache
DB_PATH=data/crypto.db
DB_URL=sqlite:///data/crypto.db

# API 
BINANCE_API_URL=https://api.binance.com
BLOCKCHAIN_API_URL=https://api.blockchain.info
ALTERNATIVE_API_URL=https://api.alternative.me
COINGECKO_API_URL=https://api.coingecko.com/api/v3
FRED_API_KEY=
# Кэш
CACHE_TTL_SECONDS=60

# Модели
# --- Модели ---
# Активные модели (через запятую)
ACTIVE_MODELS=["attention_gru","arimax_lstm"]
# Модель по умолчанию, если пользователь не выбрал явно
DEFAULT_MODEL=attention_gru
# Селектор по горизонту для режима "Auto": {h: model_name}
# Пока пусто — заполним после анализа валидации. Пример: {"1":"attention_gru","3":"arimax_lstm",...}
MODEL_SELECTOR={"1": "attention_gru", "3": "arimax_lstm", "6": "arimax_lstm", "12": "attention_gru", "18": "attention_gru"}

# --- Attention-GRU ---
GRU_MODEL_DIR=data/models/attention_gru/deploy
GRU_MODEL_FILE=attention_gru.keras
GRU_SCALER_X_FILE=scaler_X.pkl
GRU_SCALER_Y_FILE=scaler_y.pkl

GRU_CONFIG_FILE=model_config.json

# --- ARIMAX-LSTM ---
ARIMAX_MODEL_DIR=data/models/arimax_lstm/deploy
ARIMAX_STATE_FILE=arima_result.pkl
ARIMAX_CONFIG_FILE=config.json
ARIMAX_MODELS_SUBDIR=models_per_h

# --- Общие параметры моделей ---
CONFORMAL_ALPHA=0.05
LOOKBACK=30

# ACI (Adaptive Conformal Inference) — вместо статического conformal
ACI_ALPHA_TARGET=0.05
ACI_GAMMA=0.01
ACI_LOOKBACK=100
ACI_ALPHA_MIN=0.01
ACI_ALPHA_MAX=0.5